{
  "manifest_version": 3,
  "name": "nymph charts",
  "short_name": "nymph",
  "version": "@PROJECT_VERSION@",
  "description": "Turns nymph chart images on any page into live, interactive charts: pan, zoom and values on hover.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "nymph",
    "default_icon": {
      "16": "icons/on-16.png",
      "32": "icons/on-32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/loader.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/*", "src/frame/*", "src/gemini/*", "viewer/*", "viewer/fonts/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
