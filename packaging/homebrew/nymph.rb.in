# MIT License © 2026 Binary Dice Games
#
# Homebrew formula of nymph, filled in by .github/scripts/homebrew-formula.sh
# for each release and pushed to binary-dice-games/homebrew-nymph
# (spec/07_release_pipeline/DESIGN.md section 4.6). It builds the release
# source tarball; the MCP App page (generated by Emscripten, so not in the
# source tarball) comes from the same release, pinned by its SHA-256.
class Nymph < Formula
  desc "Charts and diagrams as PNG images from short YAML sources"
  homepage "https://github.com/binary-dice-games/nymph"
  url "@SOURCE_URL@"
  sha256 "@SOURCE_SHA256@"
  license "MIT"

  depends_on "cmake" => :build
  depends_on "ninja" => :build

  resource "mcp-app" do
    url "@APP_URL@"
    sha256 "@APP_SHA256@"
  end

  def install
    resource("mcp-app").stage(buildpath/"mcp-app")
    app = Dir[buildpath/"mcp-app/*.html"].first
    # Homebrew links bin/nymph onto PATH itself: no shell profile is changed.
    system "cmake", "-S", ".", "-B", "build", "-G", "Ninja",
           "-DNYMPH_BUILD_TESTS=OFF",
           "-DNYMPH_INSTALL_UPDATE_PATH=OFF",
           "-DNYMPH_MCP_VIEWER=#{app}",
           *std_cmake_args
    system "cmake", "--build", "build"
    system "cmake", "--install", "build"
  end

  test do
    (testpath/"chart.yaml").write <<~YAML
      root:
        type: Plot
        title: Revenue
        children:
          - {type: PlotLine, label: revenue, ys: $revenue}
      data: {revenue: [12, 15, 11, 18]}
    YAML
    system bin/"nymph", "render", "chart.yaml", "-o", "chart.png", "--rasterizer", "software"
    assert_path_exists testpath/"chart.png"
    assert_equal (testpath/"chart.yaml").read, shell_output("#{bin}/nymph #{testpath}/chart.png")
    assert_match version.to_s, shell_output("#{bin}/nymph --version")
  end
end
