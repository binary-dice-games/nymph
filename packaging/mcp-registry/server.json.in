{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.binary-dice-games/nymph",
  "title": "nymph",
  "description": "Charts and diagrams (plots, UML, flowcharts, Gantt, Sankey) as PNG images from YAML or mermaid.",
  "websiteUrl": "https://github.com/binary-dice-games/nymph/blob/main/docs/agents.md",
  "repository": {
    "url": "https://github.com/binary-dice-games/nymph",
    "source": "github"
  },
  "version": "@NYMPH_VERSION@",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@binary-dice-games/nymph",
      "version": "@NYMPH_VERSION@",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "mcp" }]
    }
  ]
}
