#
# nymph_embed_shapes(<target>): compiles every shape in
# resources/shapes/<category>/<name>.svg into <target>, found by its file name
# without the extension (`shape: cloud`); the category is the folder. See
# src/shapes/shape_catalog.hpp and spec/13_more_diagrams_and_shapes/DESIGN.md
# section 3. Every build embeds all of them, the web build too.
#
# Like cmake/NymphPlaceholders.cmake: one generated .cpp per file, a table
# that is rewritten when a file is added or removed (CONFIGURE_DEPENDS). The
# table's names are "category/name".

function(nymph_embed_shapes target)
  file(GLOB_RECURSE images CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/resources/shapes/*.svg")
  list(SORT images)
  set(out_dir "${CMAKE_CURRENT_BINARY_DIR}/generated/shapes")
  file(MAKE_DIRECTORY "${out_dir}")
  set(script "${PROJECT_SOURCE_DIR}/cmake/NymphEmbedFile.cmake")
  set(declarations "")
  set(entries "")
  set(sources "")
  set(seen "")
  set(index 0)
  foreach(file IN LISTS images)
    get_filename_component(name "${file}" NAME_WE)
    get_filename_component(dir "${file}" DIRECTORY)
    get_filename_component(category "${dir}" NAME)
    if(NOT name MATCHES "^[a-z][a-z0-9_]*$")
      message(FATAL_ERROR "nymph: shape '${file}' needs a lower-case name: letters, digits and '_'")
    endif()
    if(NOT category MATCHES "^[a-z][a-z0-9_]*$")
      message(FATAL_ERROR "nymph: shape '${file}' must be in a category folder with a lower-case name")
    endif()
    if(name IN_LIST seen)
      message(FATAL_ERROR "nymph: two shapes are called '${name}' (names are unique across categories): ${file}")
    endif()
    list(APPEND seen "${name}")
    set(symbol "shape_${index}")
    set(source "${out_dir}/${symbol}.cpp")
    add_custom_command(
      OUTPUT "${source}"
      COMMAND "${CMAKE_COMMAND}" "-DINPUT=${file}" "-DOUTPUT=${source}" "-DSYMBOL=${symbol}" -P "${script}"
      DEPENDS "${file}" "${script}"
      COMMENT "Embedding shape ${name}"
      VERBATIM)
    list(APPEND sources "${source}")
    string(APPEND declarations
      "extern const unsigned char ${symbol}[];\nextern const std::size_t ${symbol}_size;\n")
    string(APPEND entries "      {\"${category}/${name}\", ${symbol}, ${symbol}_size},\n")
    math(EXPR index "${index} + 1")
  endforeach()

  set(table "// Generated by cmake/NymphShapes.cmake; do not edit.\n")
  string(APPEND table "#include \"shapes/shape_catalog.hpp\"\n\n")
  string(APPEND table "namespace bdg::nymph {\n\nnamespace embedded {\n${declarations}} // namespace embedded\n\n")
  string(APPEND table "std::span<const embedded_file> embedded_shapes() {\n")
  if(index EQUAL 0)
    string(APPEND table "  return {};\n}\n\n")
  else()
    string(APPEND table "  using namespace embedded;\n")
    string(APPEND table "  static const embedded_file files[] = {\n${entries}  };\n  return files;\n}\n\n")
  endif()
  string(APPEND table "} // namespace bdg::nymph\n")
  file(WRITE "${out_dir}/shape_table.cpp.in" "${table}")
  configure_file("${out_dir}/shape_table.cpp.in" "${out_dir}/shape_table.cpp" COPYONLY)
  target_sources(${target} PRIVATE ${sources} "${out_dir}/shape_table.cpp")
endfunction()
