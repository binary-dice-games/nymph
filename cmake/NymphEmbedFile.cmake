#
# Script mode: turns one file into a C++ source defining its bytes.
#
#   cmake -DINPUT=<file> -DOUTPUT=<file.cpp> -DSYMBOL=<identifier> -P NymphEmbedFile.cmake
#
# Defines, in namespace bdg::nymph::embedded,
#   extern const unsigned char <SYMBOL>[];      // the bytes, plus a 0 terminator
#   extern const std::size_t <SYMBOL>_size;     // the file size, without it
# The terminator keeps an empty file a valid array and lets text files be
# used as C strings.

foreach(var INPUT OUTPUT SYMBOL)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "NymphEmbedFile.cmake: ${var} is not set")
  endif()
endforeach()

file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" hex_length)
math(EXPR size "${hex_length} / 2")

# 32 bytes (64 hex digits) per line keeps every line short, which MSVC
# needs; then every byte becomes "0x..,".
set(line_pattern "")
foreach(i RANGE 1 64)
  string(APPEND line_pattern "[0-9a-f]")
endforeach()
string(REGEX REPLACE "(${line_pattern})" "\\1\n" hex "${hex}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")

get_filename_component(input_name "${INPUT}" NAME)
file(WRITE "${OUTPUT}.tmp"
  "// Generated by cmake/NymphEmbedFile.cmake from ${input_name}; do not edit.\n"
  "#include <cstddef>\n\n"
  "namespace bdg::nymph::embedded {\n\n"
  "extern const unsigned char ${SYMBOL}[] = {\n${bytes}0x00};\n"
  "extern const std::size_t ${SYMBOL}_size = ${size};\n\n"
  "} // namespace bdg::nymph::embedded\n")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
