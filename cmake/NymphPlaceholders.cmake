#
# nymph_embed_placeholders(<target>): compiles every placeholder image in
# placeholders/*.svg into <target>, found by its name without the
# extension (`image: person`); see src/placeholders/placeholders.hpp and
# spec/09_ui_mockups/DESIGN.md section 3, "Placeholder images". Every
# build embeds all of them (a few KB), the web build too.
#
# Each file becomes its own generated .cpp (cmake/NymphEmbedFile.cmake),
# rebuilt only when that file changes; adding or removing a file re-runs
# the configure step (CONFIGURE_DEPENDS), which rewrites the table.

function(nymph_embed_placeholders target)
  file(GLOB images CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/placeholders/*.svg")
  list(SORT images)
  set(out_dir "${CMAKE_CURRENT_BINARY_DIR}/generated/placeholders")
  file(MAKE_DIRECTORY "${out_dir}")
  set(script "${PROJECT_SOURCE_DIR}/cmake/NymphEmbedFile.cmake")
  set(declarations "")
  set(entries "")
  set(sources "")
  set(index 0)
  foreach(file IN LISTS images)
    get_filename_component(name "${file}" NAME_WE)
    if(NOT name MATCHES "^[a-z][a-z0-9_]*$")
      message(FATAL_ERROR "nymph: placeholder '${name}.svg' needs a lower-case name: letters, digits and '_'")
    endif()
    set(symbol "placeholder_${index}")
    set(source "${out_dir}/${symbol}.cpp")
    add_custom_command(
      OUTPUT "${source}"
      COMMAND "${CMAKE_COMMAND}" "-DINPUT=${file}" "-DOUTPUT=${source}" "-DSYMBOL=${symbol}" -P "${script}"
      DEPENDS "${file}" "${script}"
      COMMENT "Embedding placeholder ${name}"
      VERBATIM)
    list(APPEND sources "${source}")
    string(APPEND declarations
      "extern const unsigned char ${symbol}[];\nextern const std::size_t ${symbol}_size;\n")
    string(APPEND entries "      {\"${name}\", ${symbol}, ${symbol}_size},\n")
    math(EXPR index "${index} + 1")
  endforeach()

  set(table "// Generated by cmake/NymphPlaceholders.cmake; do not edit.\n")
  string(APPEND table "#include \"placeholders/placeholders.hpp\"\n\n")
  string(APPEND table "namespace bdg::nymph {\n\nnamespace embedded {\n${declarations}} // namespace embedded\n\n")
  string(APPEND table "std::span<const embedded_file> embedded_placeholders() {\n")
  if(index EQUAL 0)
    string(APPEND table "  return {};\n}\n\n")
  else()
    string(APPEND table "  using namespace embedded;\n")
    string(APPEND table "  static const embedded_file files[] = {\n${entries}  };\n  return files;\n}\n\n")
  endif()
  string(APPEND table "} // namespace bdg::nymph\n")
  file(WRITE "${out_dir}/placeholder_table.cpp.in" "${table}")
  configure_file("${out_dir}/placeholder_table.cpp.in" "${out_dir}/placeholder_table.cpp" COPYONLY)
  target_sources(${target} PRIVATE ${sources} "${out_dir}/placeholder_table.cpp")
endfunction()
